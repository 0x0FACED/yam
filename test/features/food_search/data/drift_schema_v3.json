          "sql": "CREATE TABLE IF NOT EXISTS \"user_servings\" (\"id\" TEXT NOT NULL, \"food_id\" TEXT NOT NULL REFERENCES user_foods (id), \"unit\" TEXT NOT NULL, \"label\" TEXT NULL, \"base_amount\" REAL NOT NULL, \"default_amount\" REAL NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
