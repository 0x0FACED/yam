      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_foods\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"brand\" TEXT NULL, \"barcode\" TEXT NULL UNIQUE, \"basis_unit\" TEXT NOT NULL, \"basis_amount\" REAL NOT NULL, \"display_basis\" TEXT NOT NULL, \"energy_kcal\" REAL NOT NULL, \"protein_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
